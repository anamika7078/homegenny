## Local development defaults
# Copy to `.env.local` if you want per-machine overrides.

NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Optional: explicit WS base (otherwise derived from NEXT_PUBLIC_API_URL)
# NEXT_PUBLIC_WS_URL=http://localhost:3001

# Optional: list the seeded demo accounts and their shared password on the
# login page. Read at build time, so `next dev` needs a restart after a change
# and a production image needs the same value as a --build-arg.
# NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=true

